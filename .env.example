# LLM provider: "openai" (default) or "anthropic"
LLM_PROVIDER=openai
# Models are pinned explicitly — never "latest"
OPENAI_MODEL=gpt-4o-mini-2024-07-18
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Qdrant. Leave QDRANT_URL empty to use embedded local mode (./qdrant_storage),
# set to http://localhost:6333 when running the docker-compose Qdrant.
QDRANT_URL=

# Base URL the Streamlit frontend uses to reach the API
API_URL=http://localhost:8000
